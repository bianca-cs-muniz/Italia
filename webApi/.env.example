# Conexão pooled (usada em runtime pela aplicação).
DATABASE_URL="postgresql://usuario:senha@host-pooler/nomedobanco?sslmode=require&channel_binding=require&pgbouncer=true"
# Conexão direta, sem pooler (usada só pelo Prisma Migrate). No Neon, é a
# mesma URL acima sem o "-pooler" no host.
DIRECT_URL="postgresql://usuario:senha@host/nomedobanco?sslmode=require&channel_binding=require"
PORTA=4000
# Quantos proxies ficam na frente da API (0 = nenhum, rodando local). Atrás do
# Render use 1: é o que faz o limite de requisições contar pelo IP de quem
# chamou, e não pelo do proxy.
PROXIES_CONFIAVEIS=0
# Uma ou mais origens (separadas por vírgula) autorizadas a chamar a API.
URL_FRONTEND="http://localhost:3000"
