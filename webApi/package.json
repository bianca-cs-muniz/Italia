{
  "name": "italia-plano-webapi",
  "version": "1.0.0",
  "private": true,
  "description": "API do Itália Plano — lugares salvos por trecho, fotos e checklist da viagem.",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node -r dotenv/config dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
